const submitForm = () => {
    // e.preventDefault();
    let region_id = $("#region_id").find(":selected").val();
    $("#nav_menus").empty();
    $("#tab-content").empty();
    $("#end-content").empty();
    $("#common_banner").empty();
    $("#common-content").empty();

    $("#youtube_langs").empty();
    $("#youtube_content").empty();

    $("#flipsnack_langs").empty();
    $("#flipsnack_content").empty();

    $("#pdf_langs").empty();
    $("#pdf_content").empty();

    const base_url = $("#base_url").val();

    $.ajax({
        url: `${base_url}/admin/get-language-by-country?region_id=${region_id}&type=blog`,
        contentType: false,
        processData: false,
        type: "GET",
        success: function (data) {
            if (data.includes("success")) {
                // update the form with the region selected
                $("#input_region_id").val(region_id);
                $("#content_div").css("display", "block");
                const language_list = JSON.parse(data).language_list;
                const permissions_id = JSON.parse(data).permissions_id;
                const blog_Category_array = JSON.parse(data).blog_category_array;
                var fieldHTML = ``;
                let tab_content = ``;
                let langs = [];
                let direction = (code = "");
                let youtube_langs = (youtube_content = "");
                let pdf_content =
                    (pdf_langs =
                        flipsnack_content =
                        flipsnack_langs =
                        "");

                for (i = 0; i < language_list.length; i++) {
                    let default_lang =
                        language_list[i].language.id ==
                        language_list[i].region.default_lang ?
                        "required" :
                        "";
                    let active_tab =
                        language_list[i].language.id ==
                        language_list[i].region.default_lang ?
                        "active" :
                        "";
                    direction = language_list[i].language.direction;
                    code = language_list[i].language.code;
                    icon = language_list[i].language.icon;
                    title = language_list[i].language.title;
                    let lang_id = language_list[i].language.id;

                    fieldHTML += ` <li class="nav-item inline">  <a class="nav-link  ${active_tab}" href="" data-toggle="tab" data-target="#tab_details${i + 1
                        }">   <span class="text-md"><span class="label light text-dark lang-label"><img src="${base_url}/assets/dashboard/images/flags/${language_list[i].language.icon
                        }.svg" alt=""> <small>${language_list[i].language.title
                        }</small></span></span>  </a> </li>`;

                    youtube_langs += `  <li class="nav-item inline">     <a class="nav-link ${active_tab}" 
                                               href="" data-toggle="tab"
                                               data-target="#tab${i + 1}">
                                               <span class="text-md"><span class="label light text-dark lang-label"><img
                                                           src="${base_url}/assets/dashboard/images/flags/${icon}.svg"
                                                           alt="">
                                                       <small>${title}</small></span></span>
                                           </a>
                                       </li>
                    `;

                    flipsnack_langs += `  <li class="nav-item inline">     <a class="nav-link ${active_tab}" 
                    href="" data-toggle="tab"
                    data-target="#tab_flipsnack_${i + 1}">
                    <span class="text-md"><span class="label light text-dark lang-label"><img
                                src="${base_url}/assets/dashboard/images/flags/${icon}.svg"
                                alt="">
                            <small>${title}</small></span></span>
                </a>
            </li>
`;
                    pdf_langs += `  <li class="nav-item inline">     
                    <a class="nav-link ${active_tab}" 
href="" data-toggle="tab"
data-target="#tab_pdf_${i + 1}">
<span class="text-md"><span class="label light text-dark lang-label"><img
            src="${base_url}/assets/dashboard/images/flags/${icon}.svg"
            alt="">
        <small>${title}</small></span></span>
</a>
</li>
`;

                    youtube_content += ` <div class="tab-pane   ${active_tab}" id="tab${i + 1
                        }">
                    <div class="box-body" id="youtube-box-body_edit_${code}">
                        <div class="common">
                            <div class="form-group row">
                                <div class="col-sm-3"> <label class="form-control-label"> Description
                                    </label>
                                </div>
                                <div class="col-sm-9"> <input type="text" placeholder=""
                                        class="form-control"
                                        name="desc_${code}"
                                        id="youtube_desc_${code}"
                                        type="text" value="" ${default_lang}> </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-sm-3"> <label class="form-control-label"> Youtube Link
                                    </label>
                                </div>
                                <div class="col-sm-9"> <input type="url" placeholder=""
                                        class="form-control"
                                        name="link_${code}"
                                        id="youtube_link_${code}"
                                        type="text" value="" ${default_lang}>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                    `;
                    pdf_content += `
                    <div class="tab-pane   ${active_tab}" id="tab_pdf_${i + 1}">
                                           <div class="box-body" id="pdf-box-body_edit_${code}">
                                               <div class="common">
                                                   <div class="form-group row">
                                                       <div class="col-sm-3"> <label class="form-control-label">
                                                               Description
                                                           </label>
                                                       </div>
                                                       <div class="col-sm-9"> <input type="text" placeholder=""
                                                               class="form-control" name="desc_${code}"
                                                               id="pdf_desc_${code}" type="text"
                                                               value="" ${default_lang}> </div>
                                                   </div>
                                                   <div class="form-group row">
                                                       <div class="col-sm-3"> <label class="form-control-label">
                                                               Link
                                                           </label>
                                                       </div>
                                                       <div class="col-sm-9"> <input type="url" placeholder=""
                                                               class="form-control" name="link_${code}"
                                                               id="pdf_link_${code}" type="text"
                                                               value="" ${default_lang}>
                                                       </div>
                                                   </div>


                                               </div>
                                           </div>
                                       </div>
                    `;

                    flipsnack_content += `
                    <div class="tab-pane   ${active_tab}"
                    id="tab_flipsnack_${i + 1}">
                    <div class="box-body" id="flipsnack-box-body_edit_${code}">
                        <div class="common">
                            <div class="form-group row">
                                <div class="col-sm-3"> <label class="form-control-label">
                                        Description
                                    </label>
                                </div>
                                <div class="col-sm-9"> <input type="text" placeholder=""
                                        class="form-control" name="desc_${code}"
                                        id="flipsnack_desc_${code}" type="text"
                                        value="" ${default_lang}> </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-sm-3"> <label class="form-control-label">
                                        View Link
                                    </label>
                                </div>
                                <div class="col-sm-9"> <input type="url" placeholder=""
                                        class="form-control" name="link_${code}"
                                        id="flipsnack_view_link_${code}"
                                        type="text" value="" ${default_lang}>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-sm-3"> <label class="form-control-label">
                                        Download Link
                                    </label>
                                </div>
                                <div class="col-sm-9"> <input type="url" placeholder=""
                                        class="form-control"
                                        name="download_link_${code}"
                                        id="flipsnack_download_link_${code}"
                                        type="text" value="" ${default_lang}>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                    `;

                    tab_content += `  <div class="tab-pane ${active_tab} " id="tab_details${i + 1
                        }"> <div class="box-body" id="box-body_${code}">    <div class="common">        <div class="form-group row">  <div class="col-md-2"> <label class=" form-control-label"> Page Name  </label>         </div>    <div class="col-sm-10">  <input placeholder="" class="form-control"      ${default_lang} dir="${direction}"      name="page_name_${code}" id="page_name_${code}"      type="text"      oninput="generatePageSlug(this.value,'page_slug_${code}','blog',${region_id},'draft_btn','submit_btn' )">  </div>        </div>        <div class="form-group row">  <div class="col-sm-2">  <label class=" form-control-label"> Page Slug </label>  </div>  <div class="col-sm-10">  <input placeholder="" class="form-control"      ${default_lang} dir="${direction}"      name="page_slug_${code}" id="page_slug_${code}"      type="text" disabled> <span id="page_slug_${ language_list[i].language.code }_error" ></span>   </div>        </div>        <div class="form-group row">  <div class="col-sm-2">  <label class=" form-control-label"> Meta Title </label>  </div>  <div class="col-sm-10"> <input placeholder="" class="form-control"      ${default_lang} dir="${direction}"      name="meta_title_${code}" id="meta_title_${code}"      type="text">  </div>        </div>        <div class="form-group row">  <div class="col-sm-2">  <label class=" form-control-label"> Meta Keyword </label>  </div>  <div class="col-sm-10">  <input placeholder="" class="form-control"      ${default_lang} dir="${direction}"      name="meta_keywoard_${code}"      id="meta_keywoard_${code}" type="text">  </div> </div> <div class="form-group row">     <div class="col-sm-2"> <label class=" form-control-label"> Meta      Description  </label>     </div>     <div class="col-sm-10">  <input placeholder="" class="form-control"      ${default_lang} dir="${direction}"      name="meta_description_${code}"      id="meta_description_${code}" type="text">     </div> </div>`;

                    tab_content += `

                    <div class="form-group row">
                        <div class="col-sm-2"> <label class=" form-control-label">
                                Blog Categories
                            </label>
                        </div>
                        <div class="col-sm-10">
                            <select multiple class="form-control blog_category "
                                id="blog_category_${code}"
                                name="blog_category_${code}[]"> `;


                    if (blog_Category_array.length > 0) {
                        blog_Category_array.forEach(element => {

                            if ((element.blog_category_content).length > 0) {
                                element.blog_category_content.forEach(blog_content => {
                                    if (blog_content.lang_id == lang_id && blog_content.title != null) {
                                        tab_content += ` <option value="${blog_content.lang_id}">
                                                ${blog_content.title}
                                            </option> `;
                                    }
                                });
                            }
                        });
                    }

                    tab_content += ` </select>
                      </div> </div>`;

                    tab_content += `<div class="card p-2 m-3">  <div class="card-header">  <h5>Content Section</h5>  </div>  <div class="container-fluid  " style="margin-top:15px">  <div class="card-body"> <div class="form-group row"> <div class="col-md-2"> <label class=" form-control-label"> Title    </label> </div> <div class="col-md-10">    <input placeholder="" class="form-control" ${default_lang} dir="${direction}" name="title_${code}" id="title_${code}" type="text"></div>      </div> <div class="form-group row"><div class="col-md-2"> <label class=" form-control-label"> Body    </label> </div> <div class="col-md-2">    <label class="switch"> <input type="checkbox" name="blog_button_toggle_${code}"  id="blog_button_toggle_${code}"  onchange="changeText('blog_button_toggle_${code}','blog_button_toggle_text_${code}')">
                     <span class="slider round"></span>    </label>    <label for="text" class="switch_inner_text" id="blog_button_toggle_text_${code}">Hide</label></div>      </div>      <div> <input id="project-html_${code}" name="body_${code}" type="hidden" /> <input id="project-data_${code}" type="hidden"
                     name="data_details_${code}" /> </div> <div id="gjs_${code}"></div>      <div class="form-group row" style=""><div class="col-12">    <label class="form-control-label"> Thumbnail Image: (230 x 140)    </label></div> <div class="row" style="margin-left:0px">    <div class="col-12"> <div style="width:80%;float:left">     <input type="text" id="thumbnail_image_${code}"  name="thumbnail_${code}" class="form-control" value=""  readonly style="margin-bottom:15px" value="">     <div class="btn btn-success mt-2 btn-sm btn-round"  id="banner" class="lib"  data-target="#showsModal" data-toggle="modal"  onclick="setModalClickBtnId(document.getElementById('thumbnail_image_${code}'));">  Select or upload Image     </div> </div> <div style="width: 18%;float:right">     <img src="${base_url}/assets/dashboard/images/image_not_found.jpg"  id="thumbnail_image_${code}_preview" height="100px"  width="auto" /> </div>  </div> </div>     </div>  </div>  </div>  </div>  <div class="card"> <div class="card-header">     <div class="row">  <div class="col-sm-2">   <h5>Button</h5>  </div>  <div class="col-md-9">   <label class="switch">  <input type="checkbox" name="button_toggle"   id="button_toggle"   onchange="changeText('button_toggle','button_toggle_text')">  <span class="slider round"></span>     </label>     <label for="text" class="switch_inner_text" id="button_toggle_text">Hide</label>  </label>  </div>    </div>      </div> <div class="container-fluid  " style="margin-top:15px">     <div class="card-body">         <div class="form-group row">   <div class="col-md-2"> <label class=" form-control-label"> Button Name       </label> </div>  <div class="col-md-10">       <input placeholder="" class="form-control" ${default_lang} dir="${direction}" name="button_name_${code}" id="button_name_${code}" type="text">   </div>  </div> <div class="form-group row">   <div class="col-md-2"> <label class=" form-control-label"> Button Link       </label> </div> <div class="col-md-10">       <input placeholder="" class="form-control" ${default_lang} dir="${direction}" name="button_link_${code}"  id="button_link_${code}" type="text">  </div>         </div>     </div>  </div> </div>`;
                    tab_content +=
                        ` <fieldset class="fieldset-design">
                     <legend class="fieldset-legend">Social Media Links :</legend>
                     <div class="form-group row">
                         <div class="col-md-2"> <label class=" form-control-label"> Facebook Link
                             </label>
     
                         </div>
     
                         <div class="col-sm-10">
                             <input placeholder="" class="form-control"
                                ${default_lang} dir="${language_list[i].language.direction}"
                                 name="fb_link_${language_list[i].language.code}"
                                 id="fb_link_${language_list[i].language.code}" type="url"
                                 >
                         </div>
                     </div>
                     <div class="form-group row">
                         <div class="col-sm-2">
                             <label class=" form-control-label"> Twitter Link </label>
                         </div>
                         <div class="col-sm-10">
                             <input placeholder="" class="form-control"
                                ${default_lang} dir="${language_list[i].language.direction}"
                                 name="twitter_link_${language_list[i].language.code}"
                                 id="twitter_link_${language_list[i].language.code}" type="text" >
                         </div>
                     </div>
                     <div class="form-group row">
                         <div class="col-sm-2">
                             <label class=" form-control-label"> Linkdin link </label>
                         </div>
                         <div class="col-sm-10"> <input placeholder="" class="form-control"
                                ${default_lang} dir="${language_list[i].language.direction}"
                                 name="linkedin_link_${language_list[i].language.code}"
                                 id="linkedin_link_${language_list[i].language.code}" type="text">
                         </div>
                     </div>
                     
                 </fieldset> </div>   </div> </div> `;
                    langs.push(language_list[i].language.code);
                }
                let common_image = `<div class="row" style="padding:12px; margin-left:10px"> 
                 <label class="form-control-label"> Banner
                </label>
                <div class="row" style="margin-left:0px">
                    <div style="width:80%;float:left">
                        <input type="text" id="modal_image" name="image" class="form-control"
                            value="" readonly style="margin-bottom:15px" value="">
                        <div class="btn btn-success mt-2 btn-sm btn-round" id="banner" class="lib"
                            data-target="#showsModal" data-toggle="modal"
                            onclick="setModalClickBtnId(document.getElementById('modal_image'));">
                            Select or upload Image
                        </div>
                    </div>
                    <div style="width: 18%;float:right">
                        <img src="${base_url}/assets/dashboard/images/image_not_found.jpg"
                            id="modal_image_preview" height="100px" width="auto" />
                    </div>
                </div>
            </div>   `;

                let common_content = `
            <div class="box-body">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-sm-2">
                            <h5>Youtube Slider</h5>

                        </div>
                        <div class="col-md-9">
                            <label class="switch">

                            <input type="checkbox" name="youtube_button_toggle"
                            id="youtube_button_toggle"
                            onchange="changeText('youtube_button_toggle','youtube_button_toggle_text')">
                        <span class="slider round"></span>
                    </label>
                    <label for="text" class="switch_inner_text" id="youtube_button_toggle_text">Hide</label>

                    </label>
                        </div>
                        <div class="col-sm-1">

                            <button type="button" class="btn btn-primary"
                               data-target="#youtube_add_modal" data-toggle="modal">
                                + Add
                                 </button>

                        </div>
                    </div>
                    
                </div>
                <div class="container-fluid  " style="margin-top:15px">
                    <div class="card-body">
                        <div class="table-responsive">
                            <div class="form-group col-md-12 col-lg-12 col-xl-12 col-sm-12 pr-3">
                                <table class="table table-bordered" id="" width="100%"
                                    cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Description</th>
                                            <th>Link</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="youtube_content_body">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
         
            
            <div class="box-body">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-sm-2">
                            <h5>Flipsnack</h5>

                        </div>
                        <div class="col-md-9">
                            <label class="switch">

                            <input type="checkbox" name="flipsnack_button_toggle"
                            id="flipsnack_button_toggle"
                            onchange="changeText('flipsnack_button_toggle','flipsnack_button_toggle_text')">
                        <span class="slider round"></span>
                    </label>
                    <label for="text" class="switch_inner_text" id="flipsnack_button_toggle_text">Hide</label>

                    </label>
                        </div>
                        <div class="col-sm-1">

                            <button type="button" class="btn btn-primary"
                               data-target="#flipsnack_add_modal" data-toggle="modal">
                                + Add
                                 </button>

                        </div>
                    </div>
                    
                </div>
                <div class="container-fluid  " style="margin-top:15px">
                    <div class="card-body">
                        <div class="table-responsive">
                            <div class="form-group col-md-12 col-lg-12 col-xl-12 col-sm-12 pr-3">
                                <table class="table table-bordered" id="" width="100%"
                                    cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Image</th>
                                            <th>Description</th>
                                            <th>Link</th>
                                            <th>Download Link</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="flipsnack_content_body">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
          <div class="box-body">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-sm-2">
                            <h5>PDF</h5>

                        </div>
                        <div class="col-md-9">
                            <label class="switch">

                            <input type="checkbox" name="pdf_button_toggle"
                            id="pdf_button_toggle"
                            onchange="changeText('pdf_button_toggle','pdf_button_toggle_text')">
                        <span class="slider round"></span>
                    </label>
                    <label for="text" class="switch_inner_text" id="pdf_button_toggle_text">Hide</label>

                    </label>
                        </div>
                        <div class="col-sm-1">

                            <button type="button" class="btn btn-primary"
                                data-target="#pdf_add_modal" data-toggle="modal">
                                + Add
                                 </button>

                        </div>
                    </div>
                    
                </div>
                <div class="container-fluid  " style="margin-top:15px">
                    <div class="card-body">
                        <div class="table-responsive">
                            <div class="form-group col-md-12 col-lg-12 col-xl-12 col-sm-12 pr-3">
                                <table class="table table-bordered" id="" width="100%"
                                    cellspacing="0">
                                    <thead>
                                        <tr>
                                    
                                            <th>Image</th>
                                            <th>Description</th>
                                            <th>Link</th>
